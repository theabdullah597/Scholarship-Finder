# Environment configuration for OpportunityAbroad
# Copy this file to .env before starting services

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT Tokens
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opportunityabroad
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/opportunityabroad

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Mail & SMTP (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@opportunityabroad.local
MAILPIT_WEB_PORT=8025

# AI Provider Settings
LLM_PROVIDER=fake
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS Settings (JSON string or comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Ports
VITE_API_URL=http://localhost:8000/api/v1
WEB_PORT=5173
API_PORT=8000

